{
	"name": "marp-slides-presenter",
	"version": "1.4.0",
	"description": "Create and present Marp markdown slides with a fullscreen mode, popout presenter view, and laser pointer.",
	"main": "src/main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "jest --coverage --silent=false",
		"test:watch": "jest --watch",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "cocoaai-it",
	"license": "MIT",
	"packageManager": "pnpm@10.33.2",
	"devDependencies": {
		"@jest/globals": "^30.4.1",
		"@kazumatu981/markdown-it-kroki": "^1.3.2",
		"@types/jest": "^29.5.12",
		"@types/node": "^16.18.86",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"esbuild": "0.17.3",
		"esbuild-plugin-copy": "^2.1.1",
		"jest": "^29.7.0",
		"markdown-it-container": "^4.0.0",
		"markdown-it-mark": "^4.0.0",
		"obsidian": "^1.5.7-1",
		"ts-jest": "^29.1.2",
		"tslib": "2.4.0",
		"typescript": "^4.9.5"
	},
	"dependencies": {
		"@marp-team/marp-core": "^3.9.0",
		"@marp-team/marpit": "^2.6.1",
		"gray-matter": "^4.0.3",
		"jszip": "^3.10.1",
		"pptxgenjs": "^4.0.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
